# Auth.js — Google OAuth client (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=

# Comma-separated list of Google account emails allowed to sign in to /admin
ALLOWED_ADMIN_EMAILS=

# Supabase project settings, service-role key (server-side only, never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — powers the "AI: translate" / "AI: tighten wording"
# buttons in the Guest View section editor. Get one at console.anthropic.com.
# Optional: those buttons just show an error if this isn't set.
ANTHROPIC_API_KEY=

# Resend — sends the emails composed on the admin Messaging page. Get a key
# at resend.com. RESEND_FROM_EMAIL defaults to Resend's shared test sender
# (onboarding@resend.dev), which works without verifying your own domain;
# set it to an address on your verified domain once you've added one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Signing secret for the Resend webhook that reports delivery status
# (sent/delivered/bounced/etc.) back to the Messaging page. Create the
# webhook in the Resend dashboard pointing at
# https://<your-domain>/api/webhooks/resend and paste its signing secret
# here. Delivery tracking silently does nothing without this set.
RESEND_WEBHOOK_SECRET=

# Base URL used to build the magic-link sign-in URL emailed to guests.
# Defaults to http://localhost:3000 if unset — set this to your production
# domain on Vercel.
NEXT_PUBLIC_SITE_URL=

# Local dev only — skips Google sign-in entirely (no Auth.js env vars needed
# above). Also lets you exercise real guest sign-in without Resend: the
# magic link is shown directly in the UI instead of being emailed. Only
# works when NODE_ENV !== "production". NEVER set this in Vercel/production
# env vars.
LOCAL_TEST_BYPASS_AUTH=
